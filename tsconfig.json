{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"@blxzer/nyan-chord": ["./packages/chord/src/index.ts"],
			"@blxzer/nyan-chord/bundler": ["./packages/chord/src/bundler.ts"],
			"@blxzer/nyan-chord/context": ["./packages/chord/src/context/index.ts"],
			"@blxzer/nyan-chord/delta": ["./packages/chord/src/delta/index.ts"],
			"@blxzer/nyan-chord/node": ["./packages/chord/src/node.ts"],
			"@blxzer/nyan-telemetry": ["./packages/telemetry/src/index.ts"],
			"@blxzer/nyan-telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"@blxzer/nyan-codemode": ["./packages/codemode/src/index.ts"],
			"@blxzer/nyan-codemode/cloudflare": ["./packages/codemode/src/cloudflare.ts"],
			"@blxzer/nyan-codemode/declarations": ["./packages/codemode/src/declarations.ts"],
			"@blxzer/nyan-codemode/portable": ["./packages/codemode/src/portable.ts"],
			"@blxzer/nyan-codemode/source": ["./packages/codemode/src/source.ts"],
			"@blxzer/nyan-codemode/worker": ["./packages/codemode/src/runtime/worker.ts"],
			"@blxzer/nyan-mcp": ["./packages/mcp/src/index.ts"],
			"@blxzer/nyan-mcp/oauth": ["./packages/mcp/src/oauth/index.ts"],
			"@blxzer/nyan-mcp/testing": ["./packages/mcp/src/testing/index.ts"],
			"@blxzer/nyan-ai": ["./packages/ai/src/index.ts"],
			"@blxzer/nyan-ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@blxzer/nyan-ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@blxzer/nyan-ai/dist/*": ["./packages/ai/src/*"],
			"@blxzer/nyan-durable": ["./packages/durable/src/index.ts"],
			"@blxzer/nyan-durable/testing": ["./packages/durable/src/testing/index.ts"],
			"@blxzer/nyan-durable/*": [
				"./packages/durable/src/*.ts",
				"./packages/durable/src/*/index.ts",
				"./packages/durable/src/*"
			],
			"@blxzer/nyan-env": ["./packages/env/src/index.ts"],
			"@blxzer/nyan-agent-core": ["./packages/agent/src/index.ts"],
			"@blxzer/nyan": ["./packages/coding-agent/src/index.ts"],
			"@blxzer/nyan/experimental/plugin": [
				"./packages/coding-agent/src/experimental/plugin.ts"
			],
			"@blxzer/nyan/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@blxzer/nyan/*": ["./packages/coding-agent/src/*"],
			"@blxzer/nyan-protocol": ["./packages/protocol/src/index.ts"],
			"@blxzer/nyan-protocol/*": ["./packages/protocol/src/*"],
			"@blxzer/nyan-client": ["./packages/client/src/index.ts"],
			"@blxzer/nyan-client/unix": ["./packages/client/src/unix.ts"],
			"@blxzer/nyan-client/*": ["./packages/client/src/*"],
			"@blxzer/nyan-server": ["./packages/server/src/index.ts"],
			"@blxzer/nyan-server/unix": ["./packages/server/src/transports/unix/index.ts"],
			"@blxzer/nyan-server/*": ["./packages/server/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@blxzer/nyan-tui": ["./packages/tui/src/index.ts"],
			"@blxzer/nyan-tui/*": ["./packages/tui/src/*"],
			"@blxzer/nyan-agent-old": ["./packages/agent-old/src/index.ts"],
			"@blxzer/nyan-agent-old/*": ["./packages/agent-old/src/*"]
		}
	},
	"include": ["scripts/model-catalog-protocol.ts", "scripts/model-catalog-protocol.test.ts", "packages/*/src/**/*", "packages/*/test/**/*", "packages/coding-agent/examples/**/*", "packages/agent/examples/**/*"],
	"exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
