{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"@nyan/chord": ["./packages/chord/src/index.ts"],
			"@nyan/chord/bundler": ["./packages/chord/src/bundler.ts"],
			"@nyan/chord/context": ["./packages/chord/src/context/index.ts"],
			"@nyan/chord/delta": ["./packages/chord/src/delta/index.ts"],
			"@nyan/chord/node": ["./packages/chord/src/node.ts"],
			"@nyan/telemetry": ["./packages/telemetry/src/index.ts"],
			"@nyan/telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"@nyan/codemode": ["./packages/codemode/src/index.ts"],
			"@nyan/codemode/declarations": ["./packages/codemode/src/declarations.ts"],
			"@nyan/codemode/source": ["./packages/codemode/src/source.ts"],
			"@nyan/codemode/worker": ["./packages/codemode/src/runtime/worker.ts"],
			"@nyan/mcp": ["./packages/mcp/src/index.ts"],
			"@nyan/mcp/oauth": ["./packages/mcp/src/oauth/index.ts"],
			"@nyan/mcp/testing": ["./packages/mcp/src/testing/index.ts"],
			"@nyan/ai": ["./packages/ai/src/index.ts"],
			"@nyan/ai/contracts": ["./packages/ai/src/contracts/index.ts"],
			"@nyan/ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@nyan/ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@nyan/ai/dist/*": ["./packages/ai/src/*"],
			"@nyan/durable": ["./packages/durable/src/index.ts"],
			"@nyan/durable/testing": ["./packages/durable/src/testing/index.ts"],
			"@nyan/durable/*": [
				"./packages/durable/src/*.ts",
				"./packages/durable/src/*/index.ts",
				"./packages/durable/src/*"
			],
			"@nyan/env": ["./packages/env/src/index.ts"],
			"@nyan/agent-core": ["./packages/agent/src/index.ts"],
			"@nyan/coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@nyan/coding-agent/experimental/plugin": [
				"./packages/coding-agent/src/experimental/plugin.ts"
			],
			"@nyan/coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@nyan/coding-agent/*": ["./packages/coding-agent/src/*"],
			"@nyan/protocol": ["./packages/protocol/src/index.ts"],
			"@nyan/protocol/*": ["./packages/protocol/src/*"],
			"@nyan/client": ["./packages/client/src/index.ts"],
			"@nyan/client/unix": ["./packages/client/src/unix.ts"],
			"@nyan/client/*": ["./packages/client/src/*"],
			"@nyan/server": ["./packages/server/src/index.ts"],
			"@nyan/server/unix": ["./packages/server/src/transports/unix/index.ts"],
			"@nyan/server/*": ["./packages/server/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@nyan/tui": ["./packages/tui/src/index.ts"],
			"@nyan/tui/*": ["./packages/tui/src/*"],
			"@nyan/agent-old": ["./packages/agent-old/src/index.ts"],
			"@nyan/agent-old/*": ["./packages/agent-old/src/*"]
		}
	},
	"include": ["scripts/model-catalog-protocol.ts", "scripts/model-catalog-protocol.test.ts", "packages/*/src/**/*", "packages/*/test/**/*", "packages/coding-agent/examples/**/*", "packages/agent/examples/**/*"],
	"exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
