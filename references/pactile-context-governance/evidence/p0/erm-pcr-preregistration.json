      { "id": "SR-3", "condition": "required runner artifact is missing or empty", "action": "stop", "source": "04 §7 HV-3" },
      { "id": "SR-4", "condition": "pre-run ERM is absent or frozenAt is not earlier than result files", "action": "mark_unverified", "source": "01 §4.12 / 04 §13" },
      { "id": "SR-5", "condition": "any global zero-tolerance counter is non-zero", "action": "stop", "source": "03 §1.2" },
      { "id": "SR-6", "condition": "same ERM replay produces different bodyHash or verdict", "action": "stop", "source": "04 §7 HV-6" },
      { "id": "SR-7", "condition": "any KB-1…KB-7 known-bad candidate is reported as pass; candidate results must be unverified and harnessVerdict must be blocked", "action": "mark_unverified", "source": "04 §7.1" }
    ],
    "frozenAt": null,
    "freezePrerequisites": [
      "caseSetHash and fixtureHash are computed from frozen canonical inputs",
      "candidate tree-hash and sourceHashes are recorded",
      "provider capability probe is recorded; configuration name alone is insufficient",
      "all gold/negative labels have source, annotator, independence and blind-review provenance",
      "workspace snapshot is isolated and productStoreAccess is none or readonly-export",
      "ERM hash is written before any result file"
    ]
  },
