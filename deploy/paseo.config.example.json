{
  "$schema": "https://paseo.sh/schemas/paseo.config.v1.json",
  "version": 1,
  "daemon": {
    "listen": "127.0.0.1:6767",
    "auth": { "password": "<bcrypt hash, see README>" }
  },
  "agents": {
    "providers": {
      "nyan": {
        "extends": "acp",
        "label": "nyan",
        "command": ["/opt/nyan-acp/bin/nyan", "acp"]
      }
    }
  }
}
